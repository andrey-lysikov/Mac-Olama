    "NSAppleEventsUsageDescription" : {
      "comment" : "Apple Events usage",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac-Olama controls Safari only when you turn on Safari Control and ask a model to open or read a page."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac-Olama управляет Safari, только когда вы включили «Управление Safari» и попросили модель открыть или прочитать страницу."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "NSCalendarsFullAccess usage",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac-Olama reads your events for a model only when you turn on Calendar and Reminders; adding one waits for your approval."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac-Olama читает ваши события для модели, только когда включены «Календарь и напоминания»; добавление события ждёт вашего подтверждения."
          }
        }
      }
    },
    "NSCalendarsUsageDescription" : {
