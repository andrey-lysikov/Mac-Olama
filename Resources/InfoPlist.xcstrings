          }
        }
      }
    },
    "NSContactsUsageDescription" : {
      "comment" : "NSContacts usage",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac-Olama looks up your contacts for a model only when you turn on Contacts and ask about someone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac-Olama ищет в ваших контактах для модели, только когда включены «Контакты» и вы спрашиваете о ком-то."
          }
        }
      }
    },
